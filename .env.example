# Local-only placeholders. Copy to .env and replace; never commit .env.
# URL-encode passwords. Runtime queries and migrations may use different roles.
DATABASE_URL="postgresql://APP_USER:REPLACE_ME@localhost:5432/smart_expense_db?schema=public"
DIRECT_URL="postgresql://MIGRATION_USER:REPLACE_ME@localhost:5432/smart_expense_db?schema=public"
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
# Canonical origin. Use HTTPS in production; HTTP is permitted only on local development hosts.
AUTH_URL="http://localhost:3000"
# Local-only receipt extraction; no paid API key. Install Ollama and pull this vision model.
# Keep Ollama loopback-only and disable its cloud features (see docs/SETUP.md).
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="gemma3:4b"
# Currency is fixed in the schema and lib/money.ts: MMK, 0 decimals; Asia/Yangon.
# Optional sample seed only: set NODE_ENV=development, ALLOW_DEV_SEED=true,
# and DEV_SEED_EMAIL to an existing local account when running db:seed:dev.
# The sample seed rejects production mode, remote hosts and other database names.
